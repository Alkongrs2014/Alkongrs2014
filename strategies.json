,1790366400],"CRDO|pbTrend":[-1,0,0,0,1790366400],"CRDO|meanRev":[-1,0,0,0,1790366400],"CRDO|sqzExp":[1,0,0,0,1790366400],"CRDO|volSpike":[-1,0,0,0,1790366400],"CRDO|momo":[1,0,0,0,1790366400],"RDDT|orb":[-1,0,0,0,1790366400],"RDDT|vwapRec":[-1,0,0,0,1790366400],"RDDT|volSpike":[1,-1,1,1790365500000,1790366400],"RDDT|momo":[1,0,0,0,1790366400],"SMCI|orb":[1,0,0,0,1790366400],"SMCI|vwapRec":[1,0,0,0,1790366400],"SMCI|brk":[1,0,0,0,1790366400],"SMCI|meanRev":[-1,0,0,0,1790366400],"SMCI|sqzExp":[1,0,0,0,1790366400],"SMCI|volSpike":[-1,0,0,0,1790366400],"SMCI|momo":[1,0,0,0,1790366400],"FSLR|orb":[1,0,0,0,1790366400],"FSLR|vwapRec":[-1,0,0,0,1790366400],"FSLR|brk":[1,0,0,0,1790366400],"FSLR|sqzExp":[-1,0,0,0,1790366400],"FSLR|rsiDiv":[1,0,0,0,1790366400]},"dirHold":3,"actMin":55,"bands":[55,70,85],"labels":["ضعيف","متوسط","قوي","قوي جداً"],"strategies":[{"id":"orb","lbl":"كسر نطاق الافتتاح","fam":"session","tf":"15m","why":"أول ثلاثين دقيقة من الجلسة ترسم نطاقاً يحمل معظم سيولة الافتتاح، والخروج منه بوضوح يُقرأ قراراً. وبعد اكتمال النطاق لا قبله — ونطاقٌ قيد التكوّن لا يُكسَر.\n\nوكان يُقرأ على فريم ‎5د‎ بنافذة خمس عشرة دقيقة، فصار على ‎15د‎ بنافذة ثلاثين (شمعتان) بعد توحيد المشروع على أربعة فريمات. الإشارة تتأخّر ~عشر دقائق ويتّسع النطاق، وهو ORB30 القياسي — وحافّته في الأرشيف اللحظي أُعيد قياسها على الفريم الجديد ولا تُنقل عن القديم.","src":"intraday"},{"id":"vwapRec","lbl":"استعادة VWAP","fam":"session","tf":"15m","why":"VWAP متوسّط سعر الجلسة مرجّحاً بالحجم — سعرُ تعادلِ من دخلوا اليوم. وعبورُه رجوعاً بعد أن كان السعر في الجهة الأخرى تحوّلٌ في ميزان الجلسة. والشرط عبورٌ فعلي لا بقاءٌ في الجهة: شمعةٌ من الستّ الأخيرة على الجهة المقابلة.\n\nونافذة «الستّ الأخيرة» تُقاس بالشمعات لا بالدقائق، فهي تتبع الفريم كما تتبعه RSI(14): كانت ثلاثين دقيقة على ‎5د‎ وصارت ساعةً ونصفاً على ‎15د‎ بعد توحيد الفريمات. أي أن العبور يُقبل أقدمَ مما كان — وهو تخفيفٌ مقصود لا سهو، لأن عدّاً أصغر (شمعتين) يجعل الشرط لا يتحقّق تقريباً.","src":"intraday"},{"id":"brk","lbl":"اختراق مستوى بحجم","fam":"trend","tf":"15m","why":"خروج السعر من أعلى أو أدنى نافذةٍ سابقة بوضوح وبحجمٍ يفوق وسيطه. الاختراق بلا حجم غالباً يُردّ، فالحجم بوابةٌ ثقيلة هنا لا زينة. وعائلةُ الاستمرار حافّتها سالبة في أرشيف هذا الكون — تُعرض بحافّتها مكتوبةً ولا تُجمَّل.","src":"both"},{"id":"pbTrend","lbl":"ارتداد داخل اتجاه","fam":"revert","tf":"1h","why":"الاتجاه الأمّ على ٤ ساعات قائم (السعر فوق متوسّط 200 والخمسين فوقه)، بينما تراجع السعر على فريم الساعة تحت متوسّط 20 بنصف مدى شمعته على الأقل وRSI في منطقةٍ وسطى: تراجعٌ داخل اتجاه لا انكسارٌ له. والمخاطرة أن الاتجاه قد يكون في طريقه للانكسار فعلاً.\n\nنظيرُه اليومي `ارتداد صاعد` مقيسٌ في الأرشيف بحافّةٍ منعدمة (‎−0.04‎ على 38,497 حالة) — يحلّ مشكلة الرؤية ولا يدّعي حافة. وهذه النسخة **ثنائية الجهة** بخلافه: الصعود في اتجاهٍ هابط راسخ حالةٌ لم يقسها الأرشيف اليومي قط، فتُقاس هنا من جديد ولا تُفترض.","src":"both"},{"id":"meanRev","lbl":"عودة من حافة بولنجر","fam":"revert","tf":"15m","why":"السعر خارج حافة بولنجر بوضوح مع تشبّعٍ في RSI وتدفّق الأموال. وأهمّ بوابةٍ فيه هي **غياب اتجاهٍ قوي**: العودة إلى المتوسّط تعمل في النطاق وتُسحق في الاتجاه، فـADX المرتفع يقلب البوابة إلى مناقِضة بدل أن يُهمَل.","src":"both"},{"id":"sqzExp","lbl":"توسّع بعد انضغاط","fam":"vol","tf":"1h","why":"عرض بولنجر كان في أضيق مئينه ثم اتّسع، والسعر خرج من مدى فترة الانضغاط.\n\nوهو **بناءٌ مختلف** عن شرط `انضغاط قبل الحركة` الذي سقط بالقياس (‎−0.48‎): ذاك كان يأخذ جهته من الميل الصاعد فيرث سلبيّة الميل — أي أن رقمه كان يقيس الميل لا الانضغاط. وهذا يأخذ جهته من **الكسر نفسه**، فهي فرضيةٌ أخرى تُقاس من جديد ولا تُفترض.","src":"both"},{"id":"rsiDiv","lbl":"تباعد لحظي","fam":"revert","tf":"1h","why":"قاعٌ أدنى في السعر وقاعٌ أعلى في RSI (أو العكس): الدافع يفقد قوّته قبل أن ينعكس السعر. نظيرُه اليومي أقوى شرطٍ في الأرشيف كلّه (حافة ‎+1.01‎ على 4,114 حالة).\n\nوبوابةُ الاتجاه هنا **مقلوبةٌ عمداً**: الأرشيف قاس أن حافّة التباعد الصاعد ترتفع من ‎+1.01‎ إلى ‎+1.97‎ حين يكون اتجاه السهم هابطاً قوياً — إشارةُ ارتدادٍ لا معنى لها إلا حيث يوجد ما يُرتدّ عنه. فمكافأةُ موافقة الاتجاه هنا كانت ستعاقب أفضل الحالات.","src":"both"},{"id":"volSpike","lbl":"دفعة حجم موجَّهة","fam":"vol","tf":"15m","why":"شمعةٌ مكتملة بحجمٍ يفوق وسيط عشرين شمعة بمرّتين ونصف، وإغلاقها في طرف مداها فتقول جهة. والحجم وحده ليس اتجاهاً — شمعةُ حجمٍ تغلق في منتصف مداها تصف صراعاً لا قراراً، ولذلك موضع الإغلاق شرطٌ في المشغِّل لا بوابةٌ فيه.\n\nونظيرُه اليومي `حجم غير معتاد` مفروضُ الاتجاه بقرارٍ صريح في `scans.js` مع تحفّظٍ مسجَّل. هنا الجهة تأتي من الشمعة نفسها لا بفرض.","src":"both"},{"id":"momo","lbl":"زخم MACD متوافق","fam":"trend","tf":"1h","why":"هيستوغرام MACD في نفس الجهة على فريمَي ١٥ دقيقة والساعة، وميلُه على الساعة يزيد.\n\nعائلةُ استمرار — والأرشيف على 482 ألف شمعة قاس أن هذا الكون **يدفع على الارتداد ويعاقب على الاستمرار**، فالمتوقَّع أن تخرج حافّته سالبة. يبقى معروضاً بحافّته مكتوبةً: حذفُه لأن قياسه سيّئ إخفاءٌ للقياس، وعرضُه بلا رقمه كذبٌ بالصمت.","src":"both"},{"id":"tfAlign","lbl":"توافق الفريمات الأربعة","fam":"trend","tf":"1d","why":"الفريمات الأربعة (١٥د، ساعة، ٤ ساعات، يومي) في جهةٍ واحدة معاً. التوافق أندر من أي إشارة منفردة وأصعب على الضجيج أن يفتعله — لكنه يعني أيضاً أن الحركة بدأت وأن الدخول لم يعد مبكراً.\n\nوكانت خمسة بإضافة ‎5د‎، فسقط الخامس مع توحيد المشروع على أربعة فريمات. والنظير الرباعي **مقيسٌ في الأرشيف اليومي** بحافّةٍ سالبة: ‎−0.28‎ صعوداً على 55,022 حالة و‎−0.42‎ هبوطاً على 36,802 — أكثرُ الشروط تحقُّقاً وأسوأُها حافّةً، ويُعرض بذلك مكتوباً.\n\nوهو الآن نظيرُ `allTF` في شروط الفرص عدداً، ويبقى **منفصلاً عنها**: تلك تقرأ `tfScore` المحفوظ في الملخّص بعتبة ‎±15‎، وهذه تقرأ `an` لحظياً — ودمجُهما يربط الماسحَ بالأرشيف اليومي فيُبطله أيُّ تعديلٍ في أحدهما.","src":"both"}],"fams":{"session":"جلسة","trend":"استمرار","revert":"ارتداد","vol":"تقلّب وحجم"},"rows":[{"s":"NVDA","st":"rsiDiv","dir":-1,"sc":81,"band":2,"at":1790361204,"px0":224.415,"act":true,"ldir":-1,"lsc":81,"lband":2,"g":[["divFresh",2,1],["counterTrend",2,1],["rsiZone",1.5,0],["atLevel",1.5,1],["volConf",1,1],["obvBack",1,-1]],"lv":{"e":226.9633,"s":228.4579,"atr":1.4