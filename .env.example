# مفاتيح الوصول — انسخ هذا الملف باسم .env وضع مفاتيحك
# Finnhub (مجاني، للأسعار اللحظية):  https://finnhub.io/dashboard
FINNHUB_API_KEY=

# Twelve Data — اختياري في التشغيل المحلي، احتياط لو تعطّل Yahoo
TWELVEDATA_API_KEY=

# Yahoo أولاً: صحيح على الشبكة المنزلية (غير محظورة ولا سقف يومي)
PREFER_YAHOO=1

# منفذ الخادم المحلي
PORT=8080

# Alpaca (مجاني) — الوحيد الذي يعطي حجم الجلسة الممتدة.
# https://app.alpaca.markets  →  Home → API Keys → Generate
# بدونه يعمل كل شيء بياهو: أسعارُ ما قبل الافتتاح تصل، والحجمُ يُعلَن غيابه.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_FEED=iex
