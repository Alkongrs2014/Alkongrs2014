# مفاتيح الوصول — انسخ هذا الملف باسم .env وضع مفاتيحك

# Alpaca — **مصدر شموع الأسهم وأسعارها** (Algo Trader Plus: SIP لحظي).
# https://app.alpaca.markets  →  Home → API Keys → Generate
# حسابٌ ورقي (PAPER) يكفي: الاستعمال بياناتُ سوق لا أوامر تداول.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_FEED=sip

# الاحتياط الصريح — معطَّلٌ افتراضياً. `yahoo` يسمح لرمزٍ لم تصله شموع SIP
# بأن يُبنى كاملاً من ياهو، ويُطبع FALLBACK_PROVIDER ويُكتب في meta.json.
# STOCK_FALLBACK=yahoo

# عزل المزوّدين للاختبار: DISABLE_PROVIDERS=yahoo,stooq,finnhub,twelvedata,iex
# DISABLE_PROVIDERS=

# Finnhub — الأساسيات والتوصيات وصفقات المطّلعين (لا أسعار الأسهم بعد 2026-09-30)
FINNHUB_API_KEY=

# Twelve Data — لم يعد في مسار الأسهم؛ يبقى للأدوات القديمة وحدها
TWELVEDATA_API_KEY=

# منفذ الخادم المحلي
PORT=8080
